# DueSoon safe defaults. Copy to .env and provide secrets outside source control.

DUESOON_ENV=development
DUESOON_BIND=127.0.0.1
DUESOON_PORT=7000
DUESOON_DRY_RUN=true
DUESOON_SCHEDULER_ENABLED=false
DUESOON_SCHEDULER_WORKERS=1
DUESOON_SCHEDULER_INTERVAL_SECONDS=300

# Canvas read-only ingestion. Use an access token limited to this student.
DUESOON_CANVAS_ENABLED=false
DUESOON_CANVAS_BASE_URL=https://school.instructure.com
DUESOON_CANVAS_ACCESS_TOKEN=
DUESOON_CANVAS_TIMEOUT_SECONDS=15
DUESOON_CANVAS_MAX_ATTEMPTS=3

# Required when DUESOON_ENV=production. Generate a long random value.
DUESOON_API_TOKEN=

# Primary notification adapter. Keep disabled until ntfy HTTPS, user/token,
# topic ACL, persistent storage, and iPhone subscription are verified.
DUESOON_NTFY_ENABLED=false
DUESOON_NTFY_URL=http://ntfy:80
DUESOON_NTFY_TOPIC=
DUESOON_NTFY_TOKEN=
DUESOON_NTFY_TIMEOUT_SECONDS=10

# Self-hosted ntfy settings. Production BASE_URL must be public HTTPS.
NTFY_BIND=127.0.0.1
NTFY_PORT=8091
NTFY_BASE_URL=http://localhost:8091
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh
NTFY_BEHIND_PROXY=false

# Azure production Compose interpolation (not secrets).
DUESOON_PUBLIC_HOST=
ACME_EMAIL=

# Azure production example: mount an attached managed disk on the host and set
# this to a directory on that disk. Do not use Azure Files for SQLite.
# DUESOON_DATA_DIR=/mnt/duesoon/data
