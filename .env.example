# DueSoon safe defaults. Copy to .env and provide secrets outside source control.

DUESOON_ENV=development
DUESOON_BIND=127.0.0.1
DUESOON_PORT=7000
DUESOON_DRY_RUN=true
DUESOON_SCHEDULER_ENABLED=false
DUESOON_SCHEDULER_WORKERS=1
DUESOON_SCHEDULER_INTERVAL_SECONDS=300
DUESOON_DAILY_DIGEST_ENABLED=true
DUESOON_DAILY_DIGEST_HOUR=8
DUESOON_DAILY_DIGEST_MAX_ITEMS=5
DUESOON_EVIDENCE_RETRY_SECONDS=3600

# Canvas read-only ingestion. Use an access token limited to this student.
DUESOON_CANVAS_ENABLED=false
DUESOON_CANVAS_BASE_URL=https://school.instructure.com
DUESOON_CANVAS_ACCESS_TOKEN=
DUESOON_CANVAS_TIMEOUT_SECONDS=15
DUESOON_CANVAS_MAX_ATTEMPTS=3
DUESOON_CANVAS_FILE_MAX_BYTES=8000000

# Required when DUESOON_ENV=production. Generate a long random value.
DUESOON_API_TOKEN=

# Secure single-owner dashboard. Generate the hash with:
# python -m src.duesoon.auth.passwords hash-stdin
DUESOON_WEB_ENABLED=false
DUESOON_PUBLIC_ORIGIN=https://duesoon.example.com
DUESOON_OWNER_USERNAME=duesoon-owner
DUESOON_OWNER_PASSWORD_HASH=
DUESOON_TIMEZONE=America/New_York
DUESOON_SESSION_TTL_MINUTES=480
DUESOON_LOGIN_MAX_ATTEMPTS=5
DUESOON_LOGIN_WINDOW_SECONDS=900

# Primary notification adapter. Keep disabled until ntfy HTTPS, user/token,
# topic ACL, persistent storage, and iPhone subscription are verified.
DUESOON_NTFY_ENABLED=false
DUESOON_NTFY_URL=http://ntfy:80
DUESOON_NTFY_TOPIC=
DUESOON_NTFY_TOKEN=
DUESOON_NTFY_TIMEOUT_SECONDS=10

# Optional OpenAI-compatible assistant. The API key stays server-side; the
# owner can change primary/fallback model names from DueSoon Settings.
DUESOON_MODEL_ENABLED=false
DUESOON_MODEL_BASE_URL=https://api.openai.com/v1
DUESOON_MODEL_API_KEY=
DUESOON_MODEL_PRIMARY_MODEL=
DUESOON_MODEL_FALLBACK_MODELS=
DUESOON_MODEL_TIMEOUT_SECONDS=15
DUESOON_MODEL_MAX_INPUT_TOKENS=6000
DUESOON_MODEL_MAX_OUTPUT_TOKENS=700
DUESOON_MODEL_CALL_BUDGET=2

# Optional Google Workspace readers. Supply a refresh token granted only the
# Gmail readonly and/or Calendar readonly scopes. No send/write scopes.
DUESOON_GOOGLE_ENABLED=false
DUESOON_GOOGLE_GMAIL_ENABLED=false
DUESOON_GOOGLE_CALENDAR_ENABLED=false
DUESOON_GOOGLE_CLIENT_ID=
DUESOON_GOOGLE_CLIENT_SECRET=
DUESOON_GOOGLE_REFRESH_TOKEN=
DUESOON_GOOGLE_TIMEOUT_SECONDS=15
# Automatic read-only refresh cadence. Runs inside the single scheduler.
DUESOON_GOOGLE_SYNC_INTERVAL_SECONDS=900
DUESOON_GOOGLE_EXTRACTION_RETRY_SECONDS=3600

# Self-hosted ntfy settings. Production BASE_URL must be public HTTPS.
NTFY_BIND=127.0.0.1
NTFY_PORT=8091
NTFY_BASE_URL=http://localhost:8091
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh
NTFY_BEHIND_PROXY=false

# Azure production Compose interpolation (not secrets).
DUESOON_PUBLIC_HOST=
ACME_EMAIL=

# Azure production example: mount an attached managed disk on the host and set
# this to a directory on that disk. Do not use Azure Files for SQLite.
# DUESOON_DATA_DIR=/mnt/duesoon/data
