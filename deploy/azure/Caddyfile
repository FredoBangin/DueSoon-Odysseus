{
	email {$ACME_EMAIL}
}

{$DUESOON_PUBLIC_HOST} {
	encode zstd gzip

	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "no-referrer"
	header -Server

	# ntfy's authenticated JSON publisher posts to the server root. Route only
	# mutating root requests to ntfy; browser GET / remains the DueSoon app.
	@ntfy_json_publish {
		method POST PUT
		path /
	}
	handle @ntfy_json_publish {
		reverse_proxy ntfy:80
	}

	@duesoon path / /login /app /app/* /assets/* /static/* /api/* /health/* /docs* /redoc* /openapi.json
	handle @duesoon {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
			X-Frame-Options "DENY"
		}
		reverse_proxy duesoon:7000
	}

	handle {
		reverse_proxy ntfy:80
	}
}
